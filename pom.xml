<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nexus</groupId>
    <artifactId>void-rescue</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>VoidRescue</name>
    <description>Standalone Paper plugin that detects players stuck below the world (or stuck in an
        undead/unrespawned state - notably affecting Bedrock players connected through Geyser) and
        automatically pulls them back to spawn, plus a manual staff override command.</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- This plugin only uses stable Bukkit/Paper API (events, attributes,
             scheduler, commands) so it isn't tied to one exact Minecraft version
             the way Nexus Dimensions' datapack generator is. Bump this to match
             whatever Paper build the server actually runs if you want, but it
             isn't required for this plugin to keep working across point releases. -->
        <paper.api.version>1.21.4-R0.1-SNAPSHOT</paper.api.version>
    </properties>

    <!-- Paper's own API isn't on Maven Central - it's published to PaperMC's
         repository. This is the one thing a plain `mvn package` needs network
         access to beyond Central itself. -->
    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- provided: the real implementation is supplied by the Paper server at
             runtime - never bundled into our jar. Equivalent to Gradle's compileOnly. -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.api.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>VoidRescue-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
            </plugin>
        </plugins>
    </build>
</project>
