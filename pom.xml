<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nexusuniverse</groupId>
    <artifactId>NexusRealms</artifactId>
    <version>0.11.3</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.1-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
        </dependency>
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7.1</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <!-- sqlite-jdbc has to be physically bundled INTO the plugin jar. Paper doesn't
                 pull runtime (non-"provided") Maven dependencies onto the classpath for you the
                 way it does its own API, so without shading this in, the JDBC driver simply
                 wouldn't exist on the server at runtime and every DB call would fail with
                 ClassNotFoundException the moment the plugin tried to open a connection.

                 IMPORTANT: org.sqlite must NOT be relocated (no <relocations> block below).
                 sqlite-jdbc bundles a native .so/.dll whose JNI method bindings are compiled in
                 and hardcoded to the org.sqlite.* package name, so relocating the JAVA classes
                 to a different package doesn't (and can't) rename those compiled native symbols;
                 the JVM ends up looking for a native method under the new relocated name that
                 doesn't exist in the native library, crashing onEnable with
                 java.lang.UnsatisfiedLinkError the moment ProtectionDatabase tries to open a
                 connection, which takes down the ENTIRE plugin (Paper disables a plugin outright
                 if onEnable throws, so every command in this plugin, not just anything touching
                 the database, silently stops responding). A relocation here was tried once
                 already for the sensible reason noted in the comment that used to sit on it
                 (avoiding a version collision with another plugin's own bundled sqlite-jdbc), but
                 it's unnecessary in practice: Bukkit/Paper already gives each plugin jar its own
                 isolated classloader, so an unrelocated org.sqlite here doesn't leak into or
                 collide with any other plugin's own bundled copy. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
